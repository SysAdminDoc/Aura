    <string name="permission_microphone_title">Allow microphone recording</string>
    <string name="permission_microphone_body">Aura records only after you tap Record. The audio stays on this device until you choose Upload, and Discard deletes it.</string>
    <string name="permission_microphone_denied_body">Recording is off, but you can still browse, preview, upload files, and apply sounds. Open Android settings if you want to allow microphone access later.</string>
