    <string name="write_settings_title">Allow ringtone changes</string>
    <string name="write_settings_body">Aura needs Modify system settings access before it can set ringtones, notification sounds, or alarm sounds. Aura only changes these after you tap an apply action.</string>
    <string name="write_settings_open">Open settings</string>
    <string name="write_settings_required_short">System settings access required</string>
    <string name="write_settings_unavailable">This device does not expose the Modify system settings screen for Aura. Open Android settings manually and allow Aura to modify system settings.</string>
    <string name="permission_continue">Continue</string>
    <string name="permission_not_now">Not now</string>
    <string name="permission_open_settings">Open settings</string>
    <string name="permission_microphone_title">Allow microphone recording</string>
    <string name="permission_microphone_body">Aura records only after you tap Record. The audio stays on this device until you choose Upload, and Discard deletes it.</string>
    <string name="permission_microphone_denied_body">Recording is off, but you can still browse, preview, upload files, and apply sounds. Open Android settings if you want to allow microphone access later.</string>
    <string name="permission_notification_title">Allow daily wallpaper notifications</string>
    <string name="permission_notification_body">Aura sends a daily wallpaper reminder only after you enable Daily wallpaper. Declining keeps automatic recommendations off.</string>
    <string name="permission_notification_denied_body">Daily wallpaper reminders are off. The rest of Aura still works; open Android notification settings if you want reminders later.</string>
    <string name="permission_location_title">Allow approximate weather location</string>
    <string name="permission_location_body">Weather effects use approximate location to fetch local conditions from Open-Meteo. Aura stores rounded two-decimal coordinates and clears them when weather effects are disabled.</string>
    <string name="permission_location_denied_body">Weather effects are off. Wallpapers, videos, sounds, and manual personalization still work; open Android settings if you want local weather effects later.</string>
    <string name="community_recording_title">Recording sound</string>
    <string name="community_recording_body">Record up to 60 seconds. The file stays on this device until you choose Upload, and Discard deletes the local recording.</string>
    <string name="community_recording_stop">Stop</string>
    <string name="community_recording_discard">Discard</string>
    <string name="community_upload_visibility_title">Public upload</string>
    <string name="community_upload_visibility_body">Pressing Upload publishes this sound, its category, license, tags, and source URL to the community catalog. Cancel keeps the selected file local.</string>
    <string name="settings_weather_effects_title">Weather effects</string>
    <string name="settings_weather_effects_subtitle">Uses approximate location with Open-Meteo; Aura stores rounded two-decimal coordinates and clears them when disabled.</string>
