{
  "_comment": "Aura RTDB Security Rules. Roadmap N-2. Deploy via `firebase deploy --only database`.",
  "_comment2": "Source of truth for community moderation authorization. Mirrors the client-side VoteRepository.isAdmin check but is the actual enforcement layer (client checks are spoofable on rooted devices).",
  "_comment3": "All admin actions are gated on `auth.token.admin === true` — a Custom Claim set via Firebase Admin SDK from a trusted backend (Cloud Function, Cloud Run, or one-off script). Grant a UID with `admin.auth().setCustomUserClaims(uid, { admin: true })`.",
  "rules": {
    "votes": {
      "$contentId": {
        ".read": true,
        ".write": "auth != null",
        "upvotes": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "voters": {
          "$voterId": {
            ".validate": "newData.val() === true && (auth.uid === $voterId || auth.token.admin === true)"
          }
        }
      }
    },
    "voters": {
      "_comment": "Legacy path kept for backward compatibility with installs that read it directly.",
      "$contentId": {
        ".read": true,
        "$voterId": {
          ".write": "auth != null && (auth.uid === $voterId || auth.token.admin === true)",
          ".validate": "newData.val() === true"
        }
      }
    },
    "moderation": {
      ".read": true,
      "$contentId": {
        "_comment": "Only Custom-Claim admins can globally hide a piece of content.",
        ".write": "auth != null && auth.token.admin === true",
        ".validate": "newData.val() === true"
      }
    },
    "community_sounds": {
      ".read": true,
      "$uploadId": {
        ".write": "auth != null && (!data.exists() || data.child('uploaderUid').val() === auth.uid || auth.token.admin === true)",
        "name": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "category": { ".validate": "newData.isString() && newData.val().matches(/^(ringtone|notification|alarm)$/)" },
        "tags": {
          "$idx": { ".validate": "newData.isString() && newData.val().length <= 24" }
        },
        "uploaderUid": { ".validate": "newData.isString() && (newData.val() === auth.uid || auth.token.admin === true)" },
        "storagePath": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 512 && newData.val().matches(/^sounds\\/[^\\s]+$/)" },
        "license": { ".validate": "newData.isString() && newData.val().matches(/^(CC0|CC BY|CC BY-NC)$/)" },
        "rightsAttested": { ".validate": "newData.val() === true" },
        "rightsAttestedAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "sourceUrl": { ".validate": "newData.isString() && newData.val().length <= 2048 && newData.val().matches(/^$|^https:\\/\\/[^\\s]+$/)" }
      }
    },
    "community_wallpapers": {
      ".read": true,
      "$uploadId": {
        ".write": "auth != null && (!data.exists() || data.child('uploaderUid').val() === auth.uid || auth.token.admin === true)",
        "name": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "category": { ".validate": "newData.isString() && newData.val().matches(/^(abstract|amoled|nature|minimal|city|space|other)$/)" },
        "uploaderUid": { ".validate": "newData.isString() && (newData.val() === auth.uid || auth.token.admin === true)" },
        "storagePath": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 512 && newData.val().matches(/^wallpapers\\/[^\\s]+$/)" },
        "license": { ".validate": "newData.isString() && newData.val().matches(/^(CC0|CC BY|CC BY-NC)$/)" },
        "rightsAttested": { ".validate": "newData.val() === true" },
        "rightsAttestedAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "sourceUrl": { ".validate": "newData.isString() && newData.val().length <= 2048 && newData.val().matches(/^$|^https:\\/\\/[^\\s]+$/)" }
      }
    },
    "owner_uploads": {
      "_comment": "Private per-owner upload deletion index for new community uploads. Public feeds stay under community_sounds/community_wallpapers.",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
        ".write": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
        "sounds": {
          "$uploadId": {
            "uploadId": { ".validate": "newData.isString() && newData.val() === $uploadId" },
            "publicId": { ".validate": "newData.isString() && newData.val().matches(/^cu_[A-Za-z0-9_-]+$/)" },
            "contentType": { ".validate": "newData.val() === 'SOUND'" },
            "metadataPath": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 280" },
            "storagePath": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 512 && newData.val().matches(/^sounds\\/[^\\s]+$/)" },
            "title": { ".validate": "newData.isString() && newData.val().length <= 80" },
            "createdAt": { ".validate": "newData.isNumber() && newData.val() > 0" }
          }
        },
        "wallpapers": {
          "$uploadId": {
            "uploadId": { ".validate": "newData.isString() && newData.val() === $uploadId" },
            "publicId": { ".validate": "newData.isString() && newData.val().matches(/^cw_[A-Za-z0-9_-]+$/)" },
            "contentType": { ".validate": "newData.val() === 'WALLPAPER'" },
            "metadataPath": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 280" },
            "storagePath": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 512 && newData.val().matches(/^wallpapers\\/[^\\s]+$/)" },
            "title": { ".validate": "newData.isString() && newData.val().length <= 80" },
            "createdAt": { ".validate": "newData.isNumber() && newData.val() > 0" }
          }
        }
      }
    },
    "community_reports": {
      ".indexOn": ["status"],
      ".read": "auth != null && auth.token.admin === true",
      "$reportId": {
        ".write": "auth != null && (!data.exists() || auth.token.admin === true)",
        "contentId": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 240" },
        "contentKey": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 240" },
        "contentType": { ".validate": "newData.isString() && newData.val().matches(/^[A-Z_]{3,40}$/)" },
        "contentSource": { ".validate": "newData.isString() && newData.val().matches(/^[A-Z_]{3,40}$/)" },
        "reason": { ".validate": "newData.isString() && newData.val().matches(/^(RIGHTS|SOURCE_REMOVED|SAFETY|SPAM|OTHER)$/)" },
        "note": { ".validate": "newData.isString() && newData.val().length <= 500" },
        "sourceUrl": { ".validate": "newData.isString() && newData.val().length <= 2048 && newData.val().matches(/^$|^https:\\/\\/[^\\s]+$/)" },
        "license": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "uploaderName": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "reporterUid": { ".validate": "newData.isString() && (newData.val() === auth.uid || auth.token.admin === true)" },
        "reportedAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "status": { ".validate": "newData.isString() && newData.val().matches(/^(OPEN|HIDDEN|DISMISSED|RESTORED)$/)" },
        "resolverUid": { ".validate": "newData.isString() && auth.token.admin === true" },
        "resolvedAt": { ".validate": "newData.isNumber() && newData.val() > 0 && auth.token.admin === true" },
        "resolutionNote": { ".validate": "newData.isString() && newData.val().length <= 500 && auth.token.admin === true" }
      }
    },
    "community_report_resolutions": {
      ".read": "auth != null && auth.token.admin === true",
      "$reportId": {
        ".write": "auth != null && auth.token.admin === true",
        "reportId": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 240" },
        "status": { ".validate": "newData.isString() && newData.val().matches(/^(HIDDEN|DISMISSED|RESTORED)$/)" },
        "resolverUid": { ".validate": "newData.isString() && newData.val() === auth.uid" },
        "resolvedAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "note": { ".validate": "newData.isString() && newData.val().length <= 500" }
      }
    },
    "community_write_quotas": {
      "_comment": "Reserved for App-Checked callable backend quota counters. Regular clients cannot write counters because client-owned quota ledgers are spoofable.",
      ".read": "auth != null && auth.token.admin === true",
      "$uid": {
        ".write": "auth != null && auth.token.admin === true",
        "$day": {
          "$surface": {
            "count": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000" },
            "firstAt": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now" },
            "lastAt": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now" },
            "blockedCount": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000" },
            "lastBlockedAt": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now" }
          }
        }
      }
    },
    "community_write_dedupe": {
      "_comment": "Reserved for App-Checked callable backend duplicate-action markers such as report/content, vote/content, follow/creator, profile, and upload storage path keys.",
      ".read": "auth != null && auth.token.admin === true",
      "$uid": {
        ".write": "auth != null && auth.token.admin === true",
        "$surface": {
          "$dedupeKey": {
            "createdAt": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now" },
            "expiresAt": { ".validate": "newData.isNumber() && newData.val() > now" },
            "target": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 240" }
          }
        }
      }
    },
    "creator_profiles": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || auth.token.admin === true)"
      }
    },
    "creator_follows": {
      ".read": "auth != null",
      "$followerUid": {
        ".write": "auth != null && auth.uid === $followerUid"
      }
    },
    "collection_shares": {
      "_comment": "Shareable-collection JSON payloads exposed via aura://collection/import/{token}.",
      "$token": {
        ".read": true,
        ".write": "auth != null && (!data.exists() || data.child('createdByUid').val() === auth.uid || auth.token.admin === true)"
      }
    }
  }
}
