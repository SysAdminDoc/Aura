{
  "rules": {
    "votes": {
      "$contentId": {
        ".read": true,
        ".write": "auth != null && auth.token.admin === true",
        "upvotes": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "voters": {
          "$voterId": {
            ".validate": "newData.val() === true && (auth.uid === $voterId || auth.token.admin === true)"
          }
        }
      }
    },
    "voters": {
      "$contentId": {
        ".read": true,
        "$voterId": {
          ".write": "auth != null && auth.token.admin === true",
          ".validate": "newData.val() === true"
        }
      }
    },
    "moderation": {
      ".read": true,
      "$contentId": {
        ".write": "auth != null && auth.token.admin === true",
        ".validate": "newData.val() === true"
      }
    },
    "community_sounds": {
      ".read": true,
      "$uploadId": {
        ".write": "auth != null && (auth.token.admin === true || (data.exists() && !newData.exists() && (data.child('uploaderUid').val() === auth.uid || data.child('uploaderId').val() === auth.uid)))",
        "name": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "category": { ".validate": "newData.val() === 'ringtone' || newData.val() === 'notification' || newData.val() === 'alarm'" },
        "tags": {
          "$idx": { ".validate": "newData.isString() && newData.val().length <= 24" }
        },
        "uploaderUid": { ".validate": "newData.isString() && (newData.val() === auth.uid || auth.token.admin === true)" },
        "storagePath": { ".validate": "newData.isString() && newData.val().length > 7 && newData.val().length <= 512 && newData.val().beginsWith('sounds/')" },
        "license": { ".validate": "newData.val() === 'CC0' || newData.val() === 'CC BY' || newData.val() === 'CC BY-NC'" },
        "rightsAttested": { ".validate": "newData.val() === true" },
        "rightsAttestedAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "sourceUrl": { ".validate": "newData.isString() && newData.val().length <= 2048 && (newData.val() === '' || newData.val().beginsWith('https://'))" }
      }
    },
    "community_wallpapers": {
      ".read": true,
      "$uploadId": {
        ".write": "auth != null && (auth.token.admin === true || (data.exists() && !newData.exists() && (data.child('uploaderUid').val() === auth.uid || data.child('uploaderId').val() === auth.uid)))",
        "name": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "category": { ".validate": "newData.val() === 'abstract' || newData.val() === 'amoled' || newData.val() === 'nature' || newData.val() === 'minimal' || newData.val() === 'city' || newData.val() === 'space' || newData.val() === 'other'" },
        "uploaderUid": { ".validate": "newData.isString() && (newData.val() === auth.uid || auth.token.admin === true)" },
        "storagePath": { ".validate": "newData.isString() && newData.val().length > 11 && newData.val().length <= 512 && newData.val().beginsWith('wallpapers/')" },
        "license": { ".validate": "newData.val() === 'CC0' || newData.val() === 'CC BY' || newData.val() === 'CC BY-NC'" },
        "rightsAttested": { ".validate": "newData.val() === true" },
        "rightsAttestedAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "sourceUrl": { ".validate": "newData.isString() && newData.val().length <= 2048 && (newData.val() === '' || newData.val().beginsWith('https://'))" }
      }
    },
    "owner_uploads": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
        ".write": "auth != null && auth.token.admin === true",
        "sounds": {
          "$uploadId": {
            ".write": "auth != null && (auth.token.admin === true || (auth.uid === $uid && data.exists() && !newData.exists()))",
            "uploadId": { ".validate": "newData.isString() && newData.val() === $uploadId" },
            "publicId": { ".validate": "newData.isString() && newData.val().length > 3 && newData.val().beginsWith('cu_')" },
            "contentType": { ".validate": "newData.val() === 'SOUND'" },
            "metadataPath": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 280" },
            "storagePath": { ".validate": "newData.isString() && newData.val().length > 7 && newData.val().length <= 512 && newData.val().beginsWith('sounds/')" },
            "title": { ".validate": "newData.isString() && newData.val().length <= 80" },
            "createdAt": { ".validate": "newData.isNumber() && newData.val() > 0" }
          }
        },
        "wallpapers": {
          "$uploadId": {
            ".write": "auth != null && (auth.token.admin === true || (auth.uid === $uid && data.exists() && !newData.exists()))",
            "uploadId": { ".validate": "newData.isString() && newData.val() === $uploadId" },
            "publicId": { ".validate": "newData.isString() && newData.val().length > 3 && newData.val().beginsWith('cw_')" },
            "contentType": { ".validate": "newData.val() === 'WALLPAPER'" },
            "metadataPath": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 280" },
            "storagePath": { ".validate": "newData.isString() && newData.val().length > 11 && newData.val().length <= 512 && newData.val().beginsWith('wallpapers/')" },
            "title": { ".validate": "newData.isString() && newData.val().length <= 80" },
            "createdAt": { ".validate": "newData.isNumber() && newData.val() > 0" }
          }
        }
      }
    },
    "community_upload_deletions": {
      ".read": "auth != null && auth.token.admin === true",
      "$publicId": {
        ".write": "auth != null && ((!data.exists() && ((newData.child('uploaderUid').val() === auth.uid && newData.child('deletedByUid').val() === auth.uid && newData.child('reason').val() === 'OWNER_DELETE') || auth.token.admin === true)) || (data.exists() && auth.token.admin === true))",
        ".validate": "newData.hasChildren(['publicId', 'uploadId', 'contentType', 'metadataPath', 'storagePath', 'uploaderUid', 'deletedByUid', 'deletedAt', 'reason']) && newData.child('publicId').val() === $publicId && ((newData.child('contentType').val() === 'SOUND' && newData.child('publicId').val().beginsWith('cu_') && newData.child('metadataPath').val() === '/community_sounds/' + newData.child('uploadId').val() && newData.child('storagePath').val().beginsWith('sounds/' + newData.child('uploaderUid').val() + '/')) || (newData.child('contentType').val() === 'WALLPAPER' && newData.child('publicId').val().beginsWith('cw_') && newData.child('metadataPath').val() === '/community_wallpapers/' + newData.child('uploadId').val() && newData.child('storagePath').val().beginsWith('wallpapers/' + newData.child('uploaderUid').val() + '/')))",
        "publicId": { ".validate": "newData.isString() && newData.val().length > 3 && newData.val().length <= 260" },
        "uploadId": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 240" },
        "contentType": { ".validate": "newData.val() === 'SOUND' || newData.val() === 'WALLPAPER'" },
        "metadataPath": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 280" },
        "storagePath": { ".validate": "newData.isString() && newData.val().length > 7 && newData.val().length <= 512" },
        "uploaderUid": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 240" },
        "deletedByUid": { ".validate": "newData.isString() && (newData.val() === auth.uid || auth.token.admin === true)" },
        "deletedAt": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now" },
        "reason": { ".validate": "newData.val() === 'OWNER_DELETE' || newData.val() === 'ADMIN_TAKEDOWN'" }
      }
    },
    "community_reports": {
      ".indexOn": ["status"],
      ".read": "auth != null && auth.token.admin === true",
      "$reportId": {
        ".write": "auth != null && auth.token.admin === true",
        "contentId": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 240" },
        "contentKey": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 240" },
        "contentType": { ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 40 && newData.val() === newData.val().toUpperCase()" },
        "contentSource": { ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 40 && newData.val() === newData.val().toUpperCase()" },
        "reason": { ".validate": "newData.val() === 'RIGHTS' || newData.val() === 'SOURCE_REMOVED' || newData.val() === 'SAFETY' || newData.val() === 'SPAM' || newData.val() === 'PROVIDER_POLICY' || newData.val() === 'OTHER'" },
        "note": { ".validate": "newData.isString() && newData.val().length <= 500" },
        "sourceUrl": { ".validate": "newData.isString() && newData.val().length <= 2048 && (newData.val() === '' || newData.val().beginsWith('https://'))" },
        "license": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "uploaderName": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "uploaderUid": { ".validate": "newData.isString() && newData.val().length <= 240" },
        "reporterUid": { ".validate": "newData.isString() && (newData.val() === auth.uid || auth.token.admin === true)" },
        "reportedAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "status": { ".validate": "newData.val() === 'OPEN' || newData.val() === 'HIDDEN' || newData.val() === 'DISMISSED' || newData.val() === 'RESTORED'" },
        "resolverUid": { ".validate": "newData.isString() && auth.token.admin === true" },
        "resolvedAt": { ".validate": "newData.isNumber() && newData.val() > 0 && auth.token.admin === true" },
        "resolutionNote": { ".validate": "newData.isString() && newData.val().length <= 500 && auth.token.admin === true" }
      }
    },
    "community_report_resolutions": {
      ".read": "auth != null && auth.token.admin === true",
      "$reportId": {
        ".write": "auth != null && auth.token.admin === true",
        "reportId": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 240" },
        "status": { ".validate": "newData.val() === 'HIDDEN' || newData.val() === 'DISMISSED' || newData.val() === 'RESTORED'" },
        "resolverUid": { ".validate": "newData.isString() && newData.val() === auth.uid" },
        "resolvedAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "note": { ".validate": "newData.isString() && newData.val().length <= 500" }
      }
    },
    "community_takedown_receipts": {
      ".read": "auth != null && auth.token.admin === true",
      "$reportId": {
        ".write": "auth != null && auth.token.admin === true",
        ".validate": "newData.hasChildren(['reportId', 'contentId', 'contentType', 'contentSource', 'reason', 'action', 'status', 'uploadId', 'metadataPath', 'storagePath', 'uploaderUid', 'resolverUid', 'resolvedAt', 'note']) && newData.child('contentSource').val() === 'COMMUNITY' && newData.child('reason').val() === 'RIGHTS' && newData.child('status').val() === 'HIDDEN' && (newData.child('action').val() === 'HIDE' || newData.child('deleteState').isString()) && ((newData.child('contentType').val() === 'SOUND' && newData.child('metadataPath').val() === '/community_sounds/' + newData.child('uploadId').val() && newData.child('storagePath').val().beginsWith('sounds/')) || (newData.child('contentType').val() === 'WALLPAPER' && newData.child('metadataPath').val() === '/community_wallpapers/' + newData.child('uploadId').val() && newData.child('storagePath').val().beginsWith('wallpapers/'))) && (data.exists() || ((newData.child('contentType').val() === 'SOUND' && root.child('community_sounds').child(newData.child('uploadId').val()).child('storagePath').val() === newData.child('storagePath').val() && root.child('community_sounds').child(newData.child('uploadId').val()).child('uploaderUid').val() === newData.child('uploaderUid').val()) || (newData.child('contentType').val() === 'WALLPAPER' && root.child('community_wallpapers').child(newData.child('uploadId').val()).child('storagePath').val() === newData.child('storagePath').val() && root.child('community_wallpapers').child(newData.child('uploadId').val()).child('uploaderUid').val() === newData.child('uploaderUid').val())))",
        "reportId": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 240" },
        "contentId": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 240" },
        "contentType": { ".validate": "newData.val() === 'SOUND' || newData.val() === 'WALLPAPER'" },
        "contentSource": { ".validate": "newData.val() === 'COMMUNITY'" },
        "reason": { ".validate": "newData.val() === 'RIGHTS'" },
        "action": { ".validate": "newData.val() === 'HIDE' || newData.val() === 'DELETE'" },
        "status": { ".validate": "newData.val() === 'HIDDEN'" },
        "uploadId": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 240" },
        "metadataPath": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 280" },
        "storagePath": { ".validate": "newData.isString() && newData.val().length > 7 && newData.val().length <= 512" },
        "uploaderUid": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 240" },
        "resolverUid": { ".validate": "newData.isString() && newData.val() === auth.uid" },
        "resolvedAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "note": { ".validate": "newData.isString() && newData.val().length <= 500" },
        "deleteState": { ".validate": "newData.val() === 'STARTED' || newData.val() === 'SUCCEEDED' || newData.val() === 'FAILED'" },
        "deletedAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "storageDeleted": { ".validate": "newData.val() === true || newData.val() === false" },
        "metadataDeleted": { ".validate": "newData.val() === true || newData.val() === false" },
        "failedAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "failureStage": { ".validate": "newData.val() === 'DELETE'" },
        "failureMessage": { ".validate": "newData.isString() && newData.val().length <= 240" }
      }
    },
    "community_write_quotas": {
      ".read": "auth != null && auth.token.admin === true",
      "$uid": {
        ".write": "auth != null && auth.token.admin === true",
        "$day": {
          "$surface": {
            "count": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000" },
            "firstAt": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now" },
            "lastAt": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now" },
            "blockedCount": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000" },
            "lastBlockedAt": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now" }
          }
        }
      }
    },
    "community_write_dedupe": {
      ".read": "auth != null && auth.token.admin === true",
      "$uid": {
        ".write": "auth != null && auth.token.admin === true",
        "$surface": {
          "$dedupeKey": {
            "createdAt": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now" },
            "expiresAt": { ".validate": "newData.isNumber() && newData.val() > now" },
            "target": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 240" }
          }
        }
      }
    },
    "creator_profiles": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.token.admin === true"
      }
    },
    "creator_follows": {
      ".read": "auth != null",
      "$followerUid": {
        ".write": "auth != null && auth.token.admin === true"
      }
    },
    "community_user_blocks": {
      "$blockerUid": {
        ".read": "auth != null && (auth.uid === $blockerUid || auth.token.admin === true)",
        ".write": "auth != null && auth.token.admin === true",
        "$blockedUid": {
          ".validate": "newData.hasChildren(['blockerUid', 'blockedUid', 'createdAt', 'reason']) && newData.child('blockerUid').val() === $blockerUid && newData.child('blockedUid').val() === $blockedUid && $blockerUid !== $blockedUid",
          "blockerUid": { ".validate": "newData.isString() && newData.val() === $blockerUid" },
          "blockedUid": { ".validate": "newData.isString() && newData.val() === $blockedUid" },
          "createdAt": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now" },
          "reason": { ".validate": "newData.val() === 'SPAM' || newData.val() === 'HARASSMENT' || newData.val() === 'SAFETY' || newData.val() === 'RIGHTS' || newData.val() === 'OTHER'" }
        }
      }
    },
    "community_blocked_by": {
      "$blockedUid": {
        ".read": "auth != null && auth.token.admin === true",
        "$blockerUid": {
          ".write": "auth != null && auth.token.admin === true",
          ".validate": "newData.hasChildren(['blockerUid', 'blockedUid', 'createdAt', 'reason']) && newData.child('blockerUid').val() === $blockerUid && newData.child('blockedUid').val() === $blockedUid && $blockerUid !== $blockedUid",
          "blockerUid": { ".validate": "newData.isString() && newData.val() === $blockerUid" },
          "blockedUid": { ".validate": "newData.isString() && newData.val() === $blockedUid" },
          "createdAt": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now" },
          "reason": { ".validate": "newData.val() === 'SPAM' || newData.val() === 'HARASSMENT' || newData.val() === 'SAFETY' || newData.val() === 'RIGHTS' || newData.val() === 'OTHER'" }
        }
      }
    },
    "shared_collections": {
      "$token": {
        ".read": true,
        ".write": "auth != null && ((!data.exists() && (newData.child('createdByUid').val() === auth.uid || auth.token.admin === true)) || (data.exists() && (data.child('createdByUid').val() === auth.uid || auth.token.admin === true)))",
        ".validate": "newData.hasChildren(['version', 'payload', 'collectionName', 'itemCount', 'createdAt', 'createdByUid'])",
        "version": { ".validate": "newData.isNumber() && newData.val() === 1" },
        "payload": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 524288" },
        "collectionName": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "itemCount": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 250" },
        "createdAt": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now" },
        "createdByUid": { ".validate": "newData.isString() && (newData.val() === auth.uid || auth.token.admin === true)" }
      }
    }
  }
}
