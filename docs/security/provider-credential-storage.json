{
  "schemaVersion": 1,
  "policyKind": "providerCredentialStorage",
  "docsPath": "docs/security/provider-credential-storage.md",
  "preferencesManager": "app/src/main/java/com/freevibe/data/local/PreferencesManager.kt",
  "settingsScreen": "app/src/main/java/com/freevibe/ui/screens/settings/SettingsScreen.kt",
  "appGradle": "app/build.gradle.kts",
  "backupRules": "app/src/main/res/xml/backup_rules.xml",
  "dataExtractionRules": "app/src/main/res/xml/data_extraction_rules.xml",
  "diagnosticsDoc": "docs/support/crash-diagnostics.md",
  "privacyPolicy": "docs/privacy/privacy-policy.md",
  "dataStore": {
    "name": "freevibe_prefs",
    "filePath": "datastore/freevibe_prefs.preferences_pb",
    "backupDecision": "excludedFromCloudBackupAndDeviceTransfer",
    "atRestProtection": "appPrivateDataStoreNoKeystore",
    "keystoreDecision": "noKeystoreMigrationForCurrentOptionalProviderKeys"
  },
  "credentials": [
    {
      "id": "wallhaven-api-key",
      "provider": "Wallhaven",
      "classification": "optionalQuotaKey",
      "storage": "dataStore",
      "preferenceKey": "wallhaven_api_key",
      "buildConfigField": null,
      "gradleProperty": null,
      "settingsLabel": "Wallhaven API Key",
      "releaseDefault": "blank",
      "userControl": "Settings API Keys dialog saves the value; Clear or saving blank removes it.",
      "redactionTerms": ["apikey", "api keys", "local.properties"]
    },
    {
      "id": "pexels-api-key",
      "provider": "Pexels",
      "classification": "optionalQuotaKey",
      "storage": "dataStore",
      "preferenceKey": "pexels_api_key",
      "buildConfigField": "PEXELS_API_KEY",
      "gradleProperty": "pexels.api.key",
      "settingsLabel": "Pexels API Key",
      "releaseDefault": "blank",
      "userControl": "Settings API Keys dialog saves the value; Clear or saving blank removes it.",
      "redactionTerms": ["key", "api keys", "local.properties"]
    },
    {
      "id": "pixabay-api-key",
      "provider": "Pixabay",
      "classification": "optionalQuotaKey",
      "storage": "dataStore",
      "preferenceKey": "pixabay_api_key",
      "buildConfigField": "PIXABAY_API_KEY",
      "gradleProperty": "pixabay.api.key",
      "settingsLabel": "Pixabay API Key",
      "releaseDefault": "blank",
      "userControl": "Settings API Keys dialog saves the value; Clear or saving blank removes it.",
      "redactionTerms": ["key", "api keys", "local.properties"]
    },
    {
      "id": "freesound-api-key",
      "provider": "Freesound",
      "classification": "optionalQuotaKey",
      "storage": "dataStore",
      "preferenceKey": "freesound_api_key",
      "buildConfigField": "FREESOUND_API_KEY",
      "gradleProperty": "freesound.api.key",
      "settingsLabel": "Freesound API Key",
      "releaseDefault": "blank",
      "userControl": "Settings API Keys dialog saves the value; Clear or saving blank removes it.",
      "redactionTerms": ["token", "api keys", "local.properties"]
    },
    {
      "id": "soundcloud-client-id",
      "provider": "SoundCloud",
      "classification": "publicClientId",
      "storage": "buildConfigOnly",
      "preferenceKey": null,
      "buildConfigField": "SOUNDCLOUD_CLIENT_ID",
      "gradleProperty": "soundcloud.client.id",
      "settingsLabel": null,
      "releaseDefault": "blank",
      "userControl": "No Settings field; public releases keep the BuildConfig default blank and the dormant source returns no results.",
      "redactionTerms": ["client_id", "client IDs", "local.properties"]
    },
    {
      "id": "stability-ai-key",
      "provider": "Stability AI",
      "classification": "paidSensitiveSecret",
      "storage": "dataStore",
      "preferenceKey": "stability_ai_key",
      "buildConfigField": "STABILITY_AI_KEY",
      "gradleProperty": "stability.ai.key",
      "settingsLabel": "Stability AI API Key",
      "releaseDefault": "blank",
      "userControl": "Settings and the generated wallpaper screen can save the value; Settings Clear or saving blank removes it.",
      "redactionTerms": ["key", "api keys", "local.properties"]
    }
  ]
}
