  "firebaseCli": {
    "package": "firebase-tools",
    "version": "15.19.1"
  },
  "firebaseConfig": {
    "databaseRules": "database.rules.json",
    "emulators": {
      "database": {
        "port": 9000
      },
      "functions": {
        "port": 5001
      },
      "singleProjectMode": true,
      "storage": {
        "port": 9199
      },
      "ui": {
        "enabled": false
      }
    },
    "functions": {
      "codebase": "community",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ],
      "predeploy": "npm --prefix functions run build",
      "source": "functions"
    },
    "storageRules": "storage.rules"
  },
  "name": "aura-community-firebase-backend",
  "npmScripts": {
    "test:database-rules": "firebase emulators:exec --only database --project aura-rules-test \"node --test test/firebase/database.rules.test.mjs\"",
    "test:firebase-rules": "firebase emulators:exec --only database,storage --project aura-rules-test \"node --test test/firebase/*.rules.test.mjs\"",
    "test:functions": "npm --prefix functions test",
    "test:functions-emulator": "npm --prefix functions run build && firebase emulators:exec --only database --project aura-rules-test \"node --test --test-concurrency=1 test/firebase/functions.*.test.mjs\"",
    "test:storage-rules": "firebase emulators:exec --only storage --project aura-rules-test \"node --test test/firebase/storage.rules.test.mjs\""
  },
  "schemaVersion": 1
}
