      "database": {
        "port": 9000
      },
      "singleProjectMode": true,
      "storage": {
        "port": 9199
      },
      "ui": {
        "enabled": false
      }
    },
    "storageRules": "storage.rules"
  },
  "name": "aura-community-firebase-backend",
  "npmScripts": {
    "test:database-rules": "firebase emulators:exec --only database --project aura-rules-test \"node --test test/firebase/database.rules.test.mjs\"",
    "test:firebase-rules": "firebase emulators:exec --only database,storage --project aura-rules-test \"node --test test/firebase/*.rules.test.mjs\"",
    "test:storage-rules": "firebase emulators:exec --only storage --project aura-rules-test \"node --test test/firebase/storage.rules.test.mjs\""
  },
