{
  "schemaVersion": 1,
  "policyKind": "githubWorkflowSecretPolicy",
  "workflowDirectory": ".github/workflows",
  "requiredWorkflowPaths": [
    ".github/workflows/dependency-review.yml",
    ".github/workflows/performance.yml",
    ".github/workflows/release.yml",
    ".github/workflows/scorecard.yml",
    ".github/workflows/verify.yml"
  ],
  "forbiddenTokenPatterns": [
    "GITHUB_TOKEN",
    "github.token",
    "secrets.GITHUB_TOKEN"
  ],
  "allowedSecrets": [
    {
      "secret": "AURA_RELEASE_KEYSTORE_BASE64",
      "workflow": ".github/workflows/release.yml",
      "allowedEnvNames": [
        "AURA_RELEASE_KEYSTORE_BASE64"
      ],
      "purpose": "Base64-encoded release signing keystore used only by the release workflow."
    },
    {
      "secret": "AURA_RELEASE_KEYSTORE_PASSWORD",
      "workflow": ".github/workflows/release.yml",
      "allowedEnvNames": [
        "AURA_RELEASE_KEYSTORE_PASSWORD"
      ],
      "purpose": "Release keystore password used only while writing release signing properties."
    },
    {
      "secret": "AURA_RELEASE_KEY_ALIAS",
      "workflow": ".github/workflows/release.yml",
      "allowedEnvNames": [
        "AURA_RELEASE_KEY_ALIAS"
      ],
      "purpose": "Release signing key alias used only while writing release signing properties."
    },
    {
      "secret": "AURA_RELEASE_KEY_PASSWORD",
      "workflow": ".github/workflows/release.yml",
      "allowedEnvNames": [
        "AURA_RELEASE_KEY_PASSWORD"
      ],
      "purpose": "Release signing key password used only while writing release signing properties."
    }
  ]
}
